DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset to use SQLite locally. For PostgreSQL use a URL such as:
# DATABASE_URL=postgresql://user:password@localhost:5432/effecom
DATABASE_URL=

# Prefer login credentials so the backend can obtain a token and recover once
# from a rejected token. Keep both values private and never commit .env.
SUNBIRD_USERNAME=
SUNBIRD_PASSWORD=
SUNBIRD_BASE_URL=https://api.sunbird.ai
# Optional static token fallback when login credentials are unavailable.
SUNBIRD_ACCESS_TOKEN=
SUNBIRD_AUTH_SCHEME=Bearer
SUNBIRD_MAX_TEXT_LENGTH=2000
# Sunbird network timeouts in seconds (connect, auth response, TTS and STT).
SUNBIRD_CONNECT_TIMEOUT_SECONDS=10
SUNBIRD_AUTH_TIMEOUT_SECONDS=30
SUNBIRD_TTS_TIMEOUT_SECONDS=120
SUNBIRD_STT_TIMEOUT_SECONDS=180
SUNBIRD_MAX_AUDIO_SIZE_BYTES=26214400
SUNBIRD_MAX_AUDIO_SECONDS=300
# Optional comma-separated allowlist of Sunbird translation languages.
# Unsupported language codes are ignored with a startup warning.
SUNBIRD_TRANSLATION_LANGUAGES=ach,adh,afr,aka,alz,amh,bam,bem,ber,bfa,cgg,dag,dga,din,eng,ewe,ful,gwr,hau,ibo,ikx,kab,kau,kdi,kdj,keo,kik,kin,kln,koo,kpz,laj,led,lgg,lin,lsm,luc,lug,luo,luy,mhi,mlg,myx,nbl,nya,nuj,nyn,nyo,orm,pcm,pok,rub,ruc,run,rwm,sna,som,sot,swa,teo,tlj,tsn,ttj,wol,xho,xog,yor,zul
# Sunbird translation read timeout in seconds (default: 120).
SUNBIRD_TRANSLATION_TIMEOUT_SECONDS=120
SUNBIRD_MAX_TRANSLATE_CHARS=5000
# Comma-separated language:voice pairs.
SUNBIRD_TTS_VOICES=lug:Namuli
# STT languages verified for the Sunbird transcription endpoint.
SUNBIRD_STT_LANGUAGES=lug

# Guest sessions and quotas
GUEST_SESSION_LIFETIME_SECONDS=86400
GUEST_SESSIONS_PER_IP_PER_DAY=10
# Leave unset: Lax in DEBUG, None (requires Secure) otherwise.
GUEST_TRANSLATION_LIMIT=10
GUEST_TRANSLATION_CHAR_LIMIT=500
GUEST_TRANSCRIPTION_LIMIT=3
GUEST_AUDIO_SECONDS_LIMIT=30
GUEST_BURST_RATE=10/minute
# Defaults to false in DEBUG and true otherwise. Override only if needed.
AUTH_TRANSLATIONS_PER_DAY=200
AUTH_TRANSLATION_CHAR_LIMIT=5000

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://effecom.vercel.app
# Leave SameSite settings unset: Lax in DEBUG, None (Secure) otherwise.
# JWT_COOKIE_SECURE and JWT_COOKIE_SAMESITE optionally override JWT cookie defaults.
# Access and refresh tokens are HttpOnly; HTTPS is required in production.
# CORS_ALLOWED_ORIGINS also configures trusted CSRF origins.
DRF_ANON_RATE=20/hour

# Local video captioning. Install FFmpeg and FFprobe on the backend host.
CAPTION_MAX_UPLOAD_MB=250
CAPTION_MAX_DURATION_MIN=60
CAPTION_ALLOWED_VIDEO_EXTENSIONS=mp4,mov,mkv,webm
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
CAPTION_FFMPEG_TIMEOUT_SECONDS=300
CAPTION_FFPROBE_TIMEOUT_SECONDS=30

# Local Faster-Whisper and Celery worker settings
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=auto
WHISPER_BEAM_SIZE=5
WHISPER_VAD=true
CAPTION_WORD_TIMESTAMPS=false
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_VISIBILITY_TIMEOUT_SECONDS=25200
CAPTION_TASK_SOFT_TIMEOUT_SECONDS=21000
CAPTION_TASK_TIMEOUT_SECONDS=21600
CAPTION_TASK_MAX_RETRIES=2
CAPTION_TASK_RETRY_DELAY_SECONDS=60
CAPTION_STALE_JOB_MINUTES=15
CAPTION_HEARTBEAT_INTERVAL_SECONDS=30
CAPTION_PROGRESS_WRITE_INTERVAL_SECONDS=3
